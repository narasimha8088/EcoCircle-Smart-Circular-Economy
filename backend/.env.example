# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ============================================================

# Flask secret key - any random string (REQUIRED)
SECRET_KEY=change_this_to_any_random_string_abcd1234

# LocationIQ API Key (Free alternative to Google Maps)
# Get it free at: https://locationiq.com/register
# Used for backend geocoding/nearby facility lookups
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Carbon Interface API Key
# Get it free at: https://www.carboninterface.com/users/sign_up
CARBON_API_KEY=your_carbon_interface_api_key_here

# Google Gemini API Key (for AI Vision Analysis)
# Get it free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# JWT token expiry (in hours)
JWT_EXPIRY_HOURS=24

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=True

# Port
PORT=5000

# ── Performance / behaviour (all optional) ──────────────────────────────
# Open the browser automatically when the server starts
AUTO_OPEN_BROWSER=true
# Auto-restart on Python file changes. OFF by default because it slows start-up and every request
# once the ML libraries are loaded. Set to true only while editing backend code.
FLASK_RELOAD=False
# Seconds the AI Analyzer waits for the local image models (CLIP/YOLO/OCR) before letting Gemini
# analyze the image directly. They keep loading in the background for the next request.
PHASE1_TIME_BUDGET=25

# Seconds to wait for ONE Gemini answer, and the total for the whole analysis (stops endless waiting
# when the connection to Google is blocked/slow). Raise them only on a very slow network.
GEMINI_TIMEOUT_SECONDS=75
GEMINI_TOTAL_BUDGET_SECONDS=150
# Print a one-line Gemini connectivity check in the terminal at start-up
GEMINI_STARTUP_CHECK=true

